rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    // Validation Blueprints
    function isValidIconSet(data) {
      return data.keys().hasAll(['ownerId', 'prompt', 'createdAt'])
        && data.ownerId == request.auth.uid
        && data.prompt is string && data.prompt.size() <= 1000
        && (data.get('style', '') is string && data.get('style', '').size() <= 200)
        && (data.get('gridSize', '') is string && data.get('gridSize', '').size() <= 20)
        && (data.get('iconSize', '') is string && data.get('iconSize', '').size() <= 20)
        && (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 2000)
        && data.createdAt == request.time;
    }

    function isValidUserHistory(data) {
      return data.keys().hasAll(['prompt', 'timestamp'])
        && data.prompt is string && data.prompt.size() <= 1000
        && data.timestamp == request.time;
    }

    function isValidUserConfig(data) {
      return (data.get('stabilityApiKey', '') is string && data.get('stabilityApiKey', '').size() <= 200)
        && data.updatedAt == request.time;
    }

    // Collection Rules
    match /iconSets/{iconSetId} {
      allow create: if isSignedIn() && isValidId(iconSetId) && isValidIconSet(incoming());
      allow get: if isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(existing().ownerId) 
        && isValidIconSet(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'style', 'gridSize', 'iconSize', 'imageUrl']);
      allow delete: if isOwner(existing().ownerId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      
      match /history/{historyId} {
        allow create: if isSignedIn() && isOwner(userId) && isValidId(historyId) && isValidUserHistory(incoming());
        allow list: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /private/config {
        allow get, write: if isOwner(userId) && (request.method != 'create' && request.method != 'update' || isValidUserConfig(incoming()));
      }
    }

  }
}
