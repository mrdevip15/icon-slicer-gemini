{
  "entities": {
    "IconSet": {
      "title": "Icon Set",
      "description": "Metadata for a generated icon pack",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "prompt": { "type": "string" },
        "style": { "type": "string" },
        "gridSize": { "type": "string" },
        "iconSize": { "type": "string" },
        "storagePath": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "prompt", "createdAt"]
    },
    "UserHistory": {
      "title": "User History",
      "description": "Recent prompt history for a specific user",
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "timestamp"]
    },
    "UserConfig": {
      "title": "User Configuration",
      "description": "User specific application settings like API keys",
      "type": "object",
      "properties": {
        "stabilityApiKey": { "type": "string", "description": "Stability AI API Key" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/iconSets/{iconSetId}": {
      "schema": "IconSet",
      "description": "Collection of all icon sets generated by users"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "UserHistory",
      "description": "History of prompts for a specific user"
    },
    "/users/{userId}/private/config": {
      "schema": "UserConfig",
      "description": "Private configuration for a user"
    }
  }
}
